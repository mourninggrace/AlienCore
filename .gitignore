# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# AlienCore runtime data (machine-specific / sensitive)
config.json
config.advisor_backup.json
hardware_profile.json
learning.json
learning.json.bak
suggestions.json
update_state.json
logs/

# Claude Code session data
.claude/

# .NET build artifacts
tools/lhm_bridge/obj/

# Leftover scaffold directory
{core,gui,assets,profiles,logs}/
.aider*

# PyInstaller + Inno Setup build artefacts
build/
dist/

# License signing keypair — private key MUST NEVER be committed.
# Generated by tools/generate_license_keypair.py during deploy.
license_private.pem
license_public.b64

# Update signing keypair — private key MUST NEVER be committed.
# Generated by tools/generate_update_keypair.py; used by tools/sign_release.py
# to sign every release zip.  Anyone with this key can ship admin-level code.
update_private.pem
update_public.b64

# AlienCore session — machine-bound HMAC-signed token, not portable
session.json

# Local-only debug captures
scr shots for troubleshooting only/
scr-shots for troubleshooting/
